<%= form_with model: [ :admin, @skill ], local: true do |f| %>
  <% if @skill.errors.any? %>
    <div class="alert alert-danger"><%= @skill.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>
  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", admin_skills_path, class: "btn btn-outline-secondary" %>
<% end %>
