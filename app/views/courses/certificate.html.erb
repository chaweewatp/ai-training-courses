<div class="cert shadow-soft text-center">
  <div class="d-flex align-items-center justify-content-center gap-2 mb-3">
    <div class="brand-dot" style="width:46px;height:46px;font-size:1.2rem">S</div>
    <span class="fw-bold fs-5">SkillUp</span>
  </div>
  <div class="text-muted small fw-bold text-uppercase">Certificate of Completion</div>
  <h2 class="fw-bold mt-3 mb-1"><%= current_user.display_name %></h2>
  <p class="text-muted">has successfully completed the course</p>
  <h4 class="fw-bold" style="color:var(--brand)"><%= @course.title %></h4>
  <hr class="my-4">
  <div class="d-flex justify-content-between small text-muted">
    <span><%= @course.instructor.display_name %> — Instructor</span>
    <span>Earned <%= @certificate.earned_at.to_date %></span>
  </div>
</div>
<div class="text-center mt-4">
  <button class="btn btn-primary" onclick="window.print()">Download PDF</button>
</div>
