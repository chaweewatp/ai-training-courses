<div class="hero shadow-soft">
  <div class="text-uppercase small fw-bold opacity-75 mb-2">Learn at your own pace</div>
  <h1 class="display-5 fw-bold mb-2">Build real programming skills</h1>
  <p class="mb-3 opacity-75" style="max-width:560px">Enroll in a course, read a chapter, pass the quiz, and earn a certificate.</p>
</div>

<div class="d-flex justify-content-between align-items-center my-4">
  <h5 class="fw-bold mb-0">Available courses</h5>
  <span class="text-muted small"><%= @courses.count %> courses</span>
</div>

<div class="row g-4">
  <% @courses.each do |course| %>
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-soft h-100">
        <div class="p-4" style="background:linear-gradient(135deg,#0d9488,#10b981); color:#fff; border-radius:16px 16px 0 0">
          <div class="d-flex justify-content-between">
            <span class="chip bg-white text-dark">Course</span>
            <span class="small opacity-75"><%= course.chapters.count %> chapters</span>
          </div>
          <h5 class="fw-bold mt-4 mb-0"><%= course.title %></h5>
        </div>
        <div class="card-body d-flex flex-column">
          <p class="text-muted small flex-grow-1"><%= truncate(course.description, length: 120) %></p>
          <div class="d-flex align-items-center justify-content-between">
            <span class="small text-muted">Instructor: <%= course.instructor.email %></span>
            <%= link_to "View", course_path(course), class: "btn btn-primary btn-sm" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
  <% if @courses.empty? %>
    <p class="text-muted">No courses yet.</p>
  <% end %>
</div>
