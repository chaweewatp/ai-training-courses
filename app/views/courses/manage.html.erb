<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="fw-bold mb-1"><%= @course.title %></h4>
    <span class="text-muted small"><%= @course.students.count %> enrolled · <%= @course.total_quizzes %> quizzes · threshold <%= @course.certificate_threshold %>%</span>
  </div>
</div>

<div class="card shadow-soft p-4">
  <h6 class="fw-bold mb-3">Student progress</h6>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr class="text-muted small text-uppercase">
        <th>Student</th><th>Passed</th><th>Progress</th><th>Certificate</th><th></th>
      </tr></thead>
      <tbody>
        <% @students.each do |student| %>
          <% passed = @course.quizzes.joins(:answers).where(answers: { user_id: student.id, correct: true }).count %>
          <% total = @course.total_quizzes %>
          <% pct = total.positive? ? (passed.to_f / total * 100).round : 0 %>
          <tr>
            <td><span class="avatar me-2"><%= student.email.first(2).upcase %></span> <%= student.email %></td>
            <td><%= passed %> / <%= total %></td>
            <td style="min-width:180px">
              <div class="progress" style="height:8px"><div class="progress-bar" style="width:<%= pct %>%"></div></div>
              <span class="small text-muted"><%= pct %>%</span>
            </td>
            <td>
              <% if student.certificates.exists?(course: @course) %>
                <span class="chip badge-ok">Earned</span>
              <% elsif pct >= @course.certificate_threshold && total.positive? %>
                <span class="chip badge-warn">Eligible</span>
              <% else %>
                <span class="chip badge-err">In progress</span>
              <% end %>
            </td>
            <td><%= link_to "Review", review_student_course_path(@course, user_id: student.id), class: "btn btn-sm btn-outline-brand" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
