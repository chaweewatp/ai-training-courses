<h4 class="fw-bold mb-4">My Courses</h4>

<% if current_user.instructor? %>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h6 class="fw-bold mb-0">Courses I teach</h6>
    <%= link_to "New Course", new_course_path, class: "btn btn-primary btn-sm" %>
  </div>
  <div class="row g-3 mb-5">
    <% @owned.each do |course| %>
      <div class="col-md-6 col-lg-4">
        <div class="card shadow-soft h-100">
          <div class="card-body">
            <span class="chip <%= course.published? ? 'badge-ok' : 'badge-warn' %>"><%= course.state %></span>
            <h6 class="fw-bold mt-2"><%= course.title %></h6>
            <p class="text-muted small"><%= course.students.count %> enrolled · <%= course.chapters.count %> chapters</p>
            <div class="d-flex gap-2">
              <%= link_to "View", course_path(course), class: "btn btn-sm btn-outline-brand" %>
              <%= link_to "Manage", manage_course_path(course), class: "btn btn-sm btn-outline-brand" %>
              <%= link_to "Edit", edit_course_path(course), class: "btn btn-sm btn-outline-secondary" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
    <% if @owned.empty? %><p class="text-muted">You haven't created any courses.</p><% end %>
  </div>
<% end %>

<h6 class="fw-bold mb-3">Courses I'm enrolled in</h6>
<div class="row g-3">
  <% @enrolled.each do |course| %>
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-soft h-100">
        <div class="card-body">
          <h6 class="fw-bold"><%= course.title %></h6>
          <p class="text-muted small">Instructor: <%= course.instructor.email %></p>
          <div class="d-flex gap-2">
            <%= link_to "Continue", course_path(course), class: "btn btn-sm btn-primary" %>
            <% if current_user.certificates.exists?(course: course) %>
              <%= link_to "Certificate", certificate_course_path(course), class: "btn btn-sm btn-outline-brand" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
  <% if @enrolled.empty? %><p class="text-muted">Not enrolled in any courses yet.</p><% end %>
</div>
