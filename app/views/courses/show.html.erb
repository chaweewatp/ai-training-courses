<div class="row g-4">
  <div class="col-lg-3">
    <div class="sidebar p-2 shadow-soft sticky-top" style="top:80px">
      <div class="px-2 pt-2 pb-1 text-muted small fw-bold text-uppercase"><%= @course.title %></div>
      <% @chapters.each do |chapter| %>
        <%= link_to course_path(@course, chapter: chapter.id), class: (@chapter == chapter ? "active" : "") do %>
          <%= chapter.title %>
          <% if @owner && !chapter.published? %>
            <span class="chip badge-warn ms-1">Draft</span>
          <% end %>
        <% end %>
      <% end %>
      <% if @chapters.empty? %>
        <div class="px-2 small text-muted"><%= @owner ? "No chapters yet." : "No published chapters yet." %></div>
      <% end %>
      <hr class="mx-2 my-2">
      <% if @enrolled %>
        <% pre = current_user.test_attempts.find_by(course: @course, test_type: :pre) %>
        <% post = current_user.test_attempts.find_by(course: @course, test_type: :post) %>
        <%= link_to pre_test_course_path(@course) do %>
          Pre-test<% if pre %> <span class="small text-muted">(<%= pre.percent %>%)</span><% end %>
        <% end %>
        <%= link_to post_test_course_path(@course) do %>
          Post-test<% if post %> <span class="small text-muted">(<%= post.percent %>%)</span><% end %>
        <% end %>
        <% if @progress %>
          <div class="px-2 small text-muted">Chapter progress: <%= @progress[:passed] %>/<%= @progress[:total] %> passed</div>
        <% end %>
      <% end %>
      <% unless @enrolled %>
        <div class="px-2 pb-2">
          <%= button_to "Enroll", enroll_course_path(@course), method: :post, class: "btn btn-primary btn-sm w-100" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="col-lg-9">
    <div class="card shadow-soft p-4 p-lg-5">
      <% if @chapter %>
        <h3 class="fw-bold"><%= @chapter.title %></h3>
        <div class="mt-3"><%= markdown(@chapter.body) %></div>

        <% if @enrolled %>
          <% @chapter.quizzes.each do |quiz| %>
            <% answer = quiz.answers.find { |a| a.user_id == current_user.id } %>
            <div class="border rounded-4 p-4 mt-4" style="border-color:var(--border)!important">
              <span class="text-muted small fw-bold text-uppercase">Quiz</span>
              <p class="fw-semibold fs-5 mt-2"><%= quiz.text %></p>
              <%= form_with url: quiz_answer_path(quiz), model: Answer.new, method: :post, local: true do |f| %>
                <div class="input-group">
                  <%= text_field_tag "answer[text]", answer&.text, class: "form-control", placeholder: "Type your answer…" %>
                  <%= f.submit "Submit", class: "btn btn-primary" %>
                </div>
              <% end %>
              <% if answer %>
                <div class="mt-3 small d-flex align-items-center gap-2">
                  <% if answer.correct %>
                    <span class="chip badge-ok">Correct</span>
                  <% else %>
                    <span class="chip badge-err">Incorrect</span>
                  <% end %>
                  <% if answer.instructor_comment.present? %>
                    <span class="text-muted">Instructor: <%= answer.instructor_comment %></span>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% elsif @owner %>
          <% @chapter.quizzes.each do |quiz| %>
            <div class="border rounded-4 p-4 mt-4" style="border-color:var(--border)!important">
              <span class="text-muted small fw-bold text-uppercase">Quiz</span>
              <p class="fw-semibold fs-5 mt-2"><%= quiz.text %></p>
              <div class="small text-muted">Keywords: <%= quiz.keywords %></div>
              <div class="d-flex gap-2 mt-2">
                <%= link_to "Edit", edit_chapter_quiz_path(@chapter, quiz), class: "btn btn-sm btn-outline-secondary" %>
                <%= button_to "Delete", chapter_quiz_path(@chapter, quiz), method: :delete, class: "btn btn-sm btn-outline-danger" %>
              </div>
            </div>
          <% end %>
          <%= link_to "Add quiz", new_chapter_quiz_path(@chapter), class: "btn btn-outline-brand btn-sm mt-3" %>
          <div class="mt-3 d-flex gap-2">
            <%= button_to(@chapter.published? ? "Unpublish" : "Publish",
                          toggle_publish_course_chapter_path(@course, @chapter),
                          method: :patch,
                          class: "btn btn-sm #{@chapter.published? ? 'btn-outline-secondary' : 'btn-primary'}") %>
            <%= link_to "Edit chapter", edit_course_chapter_path(@course, @chapter), class: "btn btn-outline-secondary btn-sm" %>
            <%= link_to "Add chapter", new_course_chapter_path(@course), class: "btn btn-outline-brand btn-sm" %>
            <%= link_to "Manage tests", course_test_questions_path(@course), class: "btn btn-outline-brand btn-sm" %>
          </div>
        <% end %>
      <% else %>
        <p class="text-muted">No chapters yet.</p>
        <% if @owner %>
          <%= link_to "Add chapter", new_course_chapter_path(@course), class: "btn btn-primary" %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
