<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "SkillUp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script>
      (function(){ var t = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); document.documentElement.setAttribute('data-bs-theme', t); })();
    </script>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <script>
      window.MathJax = { tex: { inlineMath: [['$','$'], ['\\(','\\)']], displayMath: [['$$','$$'], ['\\[','\\]']] } };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js" async></script>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg sticky-top">
      <div class="container-xl">
        <%= link_to root_path, class: "navbar-brand d-flex align-items-center gap-2" do %>
          <span class="brand-dot">S</span>
          <span class="fw-bold">SkillUp</span>
        <% end %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
          <ul class="navbar-nav me-auto gap-1">
            <li class="nav-item"><%= link_to "Catalog", root_path, class: "nav-link" %></li>
            <% if user_signed_in? %>
              <li class="nav-item"><%= link_to "My Courses", my_courses_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "My Skills", my_skills_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "My Certificates", my_certificates_path, class: "nav-link" %></li>
              <% if current_user.instructor? %>
                <li class="nav-item"><%= link_to "New Course", new_course_path, class: "nav-link" %></li>
              <% end %>
              <% if current_user.admin? %>
                <li class="nav-item"><%= link_to "Admin", admin_users_path, class: "nav-link" %></li>
                <li class="nav-item"><%= link_to "Skills", admin_skills_path, class: "nav-link" %></li>
              <% end %>
            <% end %>
          </ul>
          <div class="d-flex align-items-center gap-2">
            <% if user_signed_in? %>
              <span class="text-muted small d-none d-md-inline"><%= current_user.email %></span>
              <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn-sm btn-outline-secondary" %>
            <% else %>
              <%= link_to "Sign in", new_user_session_path, class: "btn btn-sm btn-outline-brand" %>
              <%= link_to "Sign up", new_user_registration_path, class: "btn btn-sm btn-primary" %>
            <% end %>
            <button class="theme-toggle" id="themeToggle" title="Toggle light/dark">🌙</button>
          </div>
        </div>
      </div>
    </nav>

    <div class="container-xl py-4">
      <% if notice %><div class="alert alert-success"><%= notice %></div><% end %>
      <% if alert %><div class="alert alert-danger"><%= alert %></div><% end %>
      <% if flash[:reset_url] %>
        <div class="alert alert-info">
          Reset link:
          <a href="<%= flash[:reset_url] %>"><%= flash[:reset_url] %></a>
          <button type="button" class="btn btn-sm btn-outline-secondary ms-2" data-copy-text="<%= flash[:reset_url] %>">Copy</button>
        </div>
      <% end %>
      <%= yield %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      (function(){
        var toggle = document.getElementById('themeToggle');
        function sync(){ toggle.textContent = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? '☀️' : '🌙'; }
        sync();
        toggle.addEventListener('click', function(){
          var t = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-bs-theme', t);
          localStorage.setItem('theme', t);
          sync();
        });
        document.addEventListener('click', function(e){
          var btn = e.target.closest('[data-copy]');
          if (btn) {
            var code = btn.closest('.code-block').querySelector('code').innerText;
            navigator.clipboard.writeText(code).then(function(){ btn.textContent = 'Copied!'; setTimeout(function(){ btn.textContent = 'Copy'; }, 1200); });
          }
          var t = e.target.closest('[data-copy-text]');
          if (t) {
            navigator.clipboard.writeText(t.getAttribute('data-copy-text')).then(function(){ t.textContent = 'Copied!'; setTimeout(function(){ t.textContent = 'Copy'; }, 1200); });
          }
        });
      })();
    </script>
    <script>
      document.addEventListener("turbo:load", function () {
        if (window.MathJax && window.MathJax.typesetPromise) window.MathJax.typesetPromise();
      });
    </script>
  </body>
</html>
