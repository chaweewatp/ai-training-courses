<div class="card shadow-soft p-4" style="max-width:640px">
  <h4 class="fw-bold mb-3"><%= @quiz.new_record? ? "New Quiz" : "Edit Quiz" %></h4>
  <%= form_with model: [@chapter, @quiz], local: true do |f| %>
    <% if @quiz.errors.any? %><div class="alert alert-danger"><%= @quiz.errors.full_messages.to_sentence %></div><% end %>
    <div class="mb-3">
      <%= f.label :text, "Question", class: "form-label" %>
      <%= f.text_area :text, class: "form-control", rows: 3 %>
    </div>
    <div class="mb-3">
      <%= f.label :keywords, "Keywords (comma-separated)", class: "form-label" %>
      <%= f.text_field :keywords, class: "form-control", placeholder: "60, sixty" %>
    </div>
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", @chapter.course, class: "btn btn-outline-secondary" %>
  <% end %>
</div>
