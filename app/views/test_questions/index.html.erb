<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="fw-bold mb-1">Test Questions</h4>
    <span class="text-muted small"><%= @course.title %> · shared by pre-test and post-test</span>
  </div>
  <%= link_to "Add question", new_course_test_question_path(@course), class: "btn btn-primary btn-sm" %>
</div>

<div class="card shadow-soft p-4">
  <% @test_questions.each do |q| %>
    <div class="border rounded-3 p-3 mb-3" style="border-color:var(--border)!important">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <div class="fw-semibold mb-2"><%= markdown(q.text) %></div>
          <% q.options.each do |o| %>
            <div class="d-flex align-items-center gap-2 small <%= o.correct ? "" : "text-muted" %>">
              <span class="<%= o.correct ? "chip badge-ok" : "text-muted" %>"><%= o.correct ? "✓" : "" %></span>
              <span><%= markdown(o.text) %></span>
            </div>
          <% end %>
        </div>
        <div class="d-flex gap-2 flex-shrink-0">
          <%= link_to "Edit", edit_course_test_question_path(@course, q), class: "btn btn-sm btn-outline-secondary" %>
          <%= button_to "Delete", course_test_question_path(@course, q), method: :delete, class: "btn btn-sm btn-outline-danger" %>
        </div>
      </div>
    </div>
  <% end %>
  <% if @test_questions.empty? %>
    <p class="text-muted">No questions yet. Add one to enable pre/post tests.</p>
  <% end %>
</div>

<div class="mt-3">
  <%= link_to "Back to course", @course, class: "btn btn-outline-secondary btn-sm" %>
</div>
